    create  table
      "swifthub"."main"."dim_drivers__dbt_tmp"
  
    as (
      

SELECT
    driver_id,
    name AS driver_name,
    gender,
    age,
    city,
    vehicle_type,
    driver_rating,
    COUNT(*) OVER (PARTITION BY city) AS city_driver_count,
